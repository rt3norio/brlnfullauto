# BR-LN Docker Node - Configurações de Ambiente
# Copie este arquivo para config.env e ajuste as configurações conforme necessário

# ==========================================
# CONFIGURAÇÕES GERAIS
# ==========================================

# Timezone
TZ=America/Sao_Paulo

# Configuração de rede (deixe em branco para usar padrão)
DOCKER_NETWORK_SUBNET=

# ==========================================
# BITCOIN CORE
# ==========================================

# Network (mainnet, testnet, regtest)
BITCOIN_NETWORK=mainnet

# Configurações RPC
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=secure_password

# Configurações de prune (em MB, 0 para desabilitar)
BITCOIN_PRUNE=550

# Portas Bitcoin Core
BITCOIN_RPC_PORT=8332
BITCOIN_P2P_PORT=8333
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333

# ==========================================
# LND (Lightning Network Daemon)
# ==========================================

# Alias do nó Lightning
LND_ALIAS=BR-LN-Node

# Cor do nó (formato hex)
LND_COLOR=#FF6600

# Portas LND
LND_RPC_PORT=10009
LND_REST_PORT=8080
LND_P2P_PORT=9735

# Configurações de fee
LND_MIN_HTLC_MSAT=1
LND_BASE_FEE_MSAT=1000
LND_FEE_RATE=1

# ==========================================
# THUNDERHUB
# ==========================================

# Porta do Thunderhub
THUNDERHUB_PORT=3000

# Configurações de acesso
THUNDERHUB_MASTER_PASSWORD=thunderhub
THUNDERHUB_ACCOUNTS_1_NAME=Main
THUNDERHUB_ACCOUNTS_1_PASSWORD=admin

# ==========================================
# TOR
# ==========================================

# Portas Tor
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# Senha do controlador Tor (deixe em branco para gerar automaticamente)
TOR_CONTROL_PASSWORD=

# ==========================================
# I2PD
# ==========================================

# Portas i2pd
I2PD_HTTP_PORT=4444
I2PD_SAM_PORT=4447
I2PD_CONTROL_PORT=7656

# ==========================================
# CONFIGURAÇÕES DE LOGGING
# ==========================================

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# Rotação de logs
LOG_MAX_SIZE=100M
LOG_MAX_FILES=5

# ==========================================
# CONFIGURAÇÕES DE BACKUP
# ==========================================

# Diretório de backup
BACKUP_DIR=./backups

# Manter backups por quantos dias
BACKUP_RETENTION_DAYS=30

# ==========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ==========================================

# Habilitar modo de desenvolvimento
DEV_MODE=false

# Habilitar logs detalhados
VERBOSE_LOGS=false

# ==========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ==========================================

# Habilitar autenticação adicional
ENABLE_AUTH=true

# IP ranges permitidos (deixe em branco para permitir todos)
ALLOWED_IPS=

# ==========================================
# CONFIGURAÇÕES DE PERFORMANCE
# ==========================================

# Limites de memória (em MB)
BITCOIN_MEMORY_LIMIT=1024
LND_MEMORY_LIMIT=512
THUNDERHUB_MEMORY_LIMIT=256

# Limites de CPU (número de cores)
BITCOIN_CPU_LIMIT=2
LND_CPU_LIMIT=1
THUNDERHUB_CPU_LIMIT=0.5 